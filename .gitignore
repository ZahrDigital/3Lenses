# Original camera-resolution master photographs.
# These are multi-megabyte RAW-exported JPGs used only as source material.
# The site itself loads the optimized WebP versions in images/optimized/.
images/*.jpg
images/*.jpeg

# Original master video files (hundreds of MB to multiple GB).
# The site itself loads the compressed web versions in videos/optimized/.
videos/*.mp4
videos/*.mov

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp

# Local tooling (not part of the deployed site)
.claude/
